{
  "name": "Lead Capture",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-capture",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "1a1b1c1d-0001-4a1a-9a1a-000000000001",
      "name": "Webhook - Form Submission",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "lead-capture-webhook"
    },
    {
      "parameters": {
        "jsCode": "// Validate and format the incoming lead data\nconst items = $input.all();\n\nreturn items.map((item) => {\n  const body = item.json.body || item.json;\n\n  const name = (body.name || '').toString().trim();\n  const email = (body.email || '').toString().trim().toLowerCase();\n  const message = (body.message || '').toString().trim();\n\n  const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n  const errors = [];\n\n  if (!name) errors.push('name is required');\n  if (!email || !emailRegex.test(email)) errors.push('a valid email is required');\n\n  if (errors.length > 0) {\n    throw new Error(`Lead validation failed: ${errors.join(', ')}`);\n  }\n\n  return {\n    json: {\n      name,\n      email,\n      message: message || '(no message provided)',\n      source: 'website-form',\n      submittedAt: new Date().toISOString(),\n    },\n  };\n});"
      },
      "id": "1a1b1c1d-0002-4a1a-9a1a-000000000002",
      "name": "Validate & Format Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.example-crm.com/leads",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.CRM_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"name\": $json.name, \"email\": $json.email, \"message\": $json.message, \"source\": $json.source, \"submittedAt\": $json.submittedAt } }}",
        "options": {}
      },
      "id": "1a1b1c1d-0003-4a1a-9a1a-000000000003",
      "name": "Send to CRM (placeholder)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300],
      "onError": "continueRegularOutput",
      "continueOnFail": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-crm-error",
              "leftValue": "={{ $json.error }}",
              "rightValue": "",
