            }
          ]
        },
        "options": {}
      },
      "id": "4d4e4f4g-0004-4d4d-9d4d-000000000004",
      "name": "Log Invalid Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [900, 260]
    },
    {
      "parameters": {
        "jsCode": "// Map System A's field names/shape onto what System B expects and normalize dates.\nconst item = $input.first().json;\n\nfunction normalizeDate(value) {\n  if (!value) return null;\n  const d = new Date(value);\n  return isNaN(d.getTime()) ? null : d.toISOString();\n}\n\nconst systemBPayload = {\n  external_id: item.id,\n  name: item.data.full_name || item.data.name || null,\n  email_address: item.data.email || null,\n  synced_version: normalizeDate(item.data.updated_at) || new Date().toISOString(),\n  sync_status: item.data.status || null,\n};\n\nreturn [\n  {\n    json: {\n      entityId: item.id,\n      eventType: item.type,\n      systemBPayload,\n    },\n  },\n];"
      },
      "id": "4d4e4f4g-0005-4d4d-9d4d-000000000005",
      "name": "Transform to System B Shape",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 620]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.example-systemb.com/records/{{ $json.entityId }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SYSTEM_B_API_KEY }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "4d4e4f4g-0006-4d4d-9d4d-000000000006",
      "name": "Lookup Existing Record in System B",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 620]
    },
    {
      "parameters": {
        "jsCode": "// Idempotency safeguard: compare System B's current state against what we're about\n// to write. Webhook delivery is at-least-once, so retries of the same event are\n// expected - this stops a retried webhook from producing a duplicate write.\nconst lookup = $input.first().json;\nconst ctx = $('Transform to System B Shape').item.json;\n\nconst recordExists = lookup.statusCode === 200 && lookup.body && lookup.body.external_id;\nconst lookupUnexpectedError = lookup.statusCode && lookup.statusCode !== 200 && lookup.statusCode !== 404;\n\nlet alreadySynced = false;\nlet reason = '';\n\nif (lookupUnexpectedError) {\n  // Fail open: don't block a legitimate write because the idempotency check itself\n  // had trouble - a possible duplicate write is safer than a silently dropped sync.\n  alreadySynced = false;\n  reason = `Idempotency lookup returned unexpected status ${lookup.statusCode} - proceeding with write anyway`;\n} else if (ctx.eventType === 'deleted') {\n  alreadySynced = !recordExists;\n  reason = alreadySynced\n    ? 'Record already absent from System B - delete is a no-op'\n    : 'Record still present in System B - proceeding with delete';\n} else {\n  alreadySynced = Boolean(recordExists && lookup.body.synced_version === ctx.systemBPayload.synced_version);\n  reason = alreadySynced\n    ? 'System B already has this exact version - skipping duplicate write'\n    : 'System B is missing or out of date - proceeding with write';\n}\n\nreturn [\n  {\n    json: {\n      entityId: ctx.entityId,\n      eventType: ctx.eventType,\n      systemBPayload: ctx.systemBPayload,\n      alreadySynced,\n      reason,\n    },\n  },\n];"
      },
      "id": "4d4e4f4g-0007-4d4d-9d4d-000000000007",
      "name": "Check Idempotency",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 620]
    },
    {
