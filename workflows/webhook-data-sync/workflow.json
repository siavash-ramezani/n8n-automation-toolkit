      "id": "4d4e4f4g-0001-4d4d-9d4d-000000000001",
      "name": "Webhook - System A Event",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 500],
      "webhookId": "webhook-data-sync-webhook"
    },
    {
      "parameters": {
        "jsCode": "// Validate the incoming payload shape instead of letting a malformed event crash the run.\nconst items = $input.all();\n\nreturn items.map((item) => {\n  const body = item.json.body || item.json;\n  const id = body.id;\n  const type = body.type;\n  const data = body.data;\n\n  const validTypes = ['created', 'updated', 'deleted'];\n  const errors = [];\n\n  if (!id || typeof id !== 'string') errors.push('id is required and must be a string');\n  if (!validTypes.includes(type)) errors.push(`type must be one of ${validTypes.join(', ')}`);\n  if (type !== 'deleted' && (!data || typeof data !== 'object')) {\n    errors.push('data object is required for created/updated events');\n  }\n\n  return {\n    json: {\n      valid: errors.length === 0,\n      validationError: errors.join('; '),\n      id: id || null,\n      type: type || null,\n      data: data || {},\n    },\n  };\n});"
      },
      "id": "4d4e4f4g-0002-4d4d-9d4d-000000000002",
      "name": "Validate Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 500]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-payload-valid",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "4d4e4f4g-0003-4d4d-9d4d-000000000003",
      "name": "Payload Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 500]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "assign-invalid-status",
              "name": "status",
              "type": "string",
              "value": "rejected"
            },
            {
              "id": "assign-invalid-message",
