# Copy this file to .env and fill in real values in your own n8n environment.
# Never commit a real .env file.

# --- Lead Capture workflow ---

# API key for the CRM the "Send to CRM" node authenticates with (sent as a Bearer token)
CRM_API_KEY=your-crm-api-key-here

# Slack incoming webhook URL used by the "Send Slack Notification" node
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/PLACEHOLDER/PLACEHOLDER/PLACEHOLDER

# --- AI Content Moderation workflow ---

# API key for the LLM provider the "Call LLM for Classification" node authenticates with (sent as x-api-key)
LLM_API_KEY=YOUR_LLM_API_KEY_HERE

# Slack incoming webhook URL used by the #content-review / #content-rejected notification nodes
CONTENT_MODERATION_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/PLACEHOLDER/PLACEHOLDER/PLACEHOLDER
