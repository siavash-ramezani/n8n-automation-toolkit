# Copy this file to .env and fill in real values in your own n8n environment.
# Never commit a real .env file.

# --- Lead Capture workflow ---

# API key for the CRM the "Send to CRM" node authenticates with (sent as a Bearer token)
CRM_API_KEY=your-crm-api-key-here

# Slack incoming webhook URL used by the "Send Slack Notification" node
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/PLACEHOLDER/PLACEHOLDER/PLACEHOLDER
