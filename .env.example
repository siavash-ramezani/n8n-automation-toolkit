# Copy this file to .env and fill in real values in your own n8n environment.
# Never commit a real .env file.

# --- Lead Capture workflow ---

# API key for the CRM the "Send to CRM" node authenticates with (sent as a Bearer token)
CRM_API_KEY=your-crm-api-key-here

# Slack incoming webhook URL used by the "Send Slack Notification" node
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/PLACEHOLDER/PLACEHOLDER/PLACEHOLDER

# --- AI Content Moderation workflow ---

# API key for the LLM provider the "Call LLM for Classification" node authenticates with (sent as x-api-key)
LLM_API_KEY=YOUR_LLM_API_KEY_HERE

# Slack incoming webhook URL used by the #content-review / #content-rejected notification nodes
CONTENT_MODERATION_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/PLACEHOLDER/PLACEHOLDER/PLACEHOLDER

# --- Scheduled Report Generator workflow ---

# Postgres connection details used when creating the "Report DB" credential in n8n
REPORT_DB_HOST=your-db-host.example.com
REPORT_DB_NAME=your_database_name
REPORT_DB_USER=your_db_user
REPORT_DB_PASSWORD=your_db_password_here

# SMTP connection details used when creating the "Report SMTP" credential in n8n
REPORT_SMTP_HOST=smtp.example.com
REPORT_SMTP_USER=your_smtp_user
REPORT_SMTP_PASSWORD=your_smtp_password_here

# Comma-separated list of recipients for the "Send Report Email" node
REPORT_RECIPIENT_EMAILS=team@example.com,ops@example.com

# --- Webhook Data Sync workflow ---

# API key for System B, sent as a Bearer token by the Lookup/Delete/Upsert HTTP Request nodes
SYSTEM_B_API_KEY=YOUR_SYSTEM_B_API_KEY_HERE

# Slack incoming webhook URL used by the "Send Slack Failure Alert" node
SYNC_FAILURE_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/PLACEHOLDER/PLACEHOLDER/PLACEHOLDER
